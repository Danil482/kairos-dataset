# The release goes here and never into git: see README, "Get the data"
data/*
!data/.gitkeep

results/
__pycache__/
*.pyc
.venv/
.idea/
.vscode/

# Local secrets and generated launch packages never enter Git.
env/
secrets/
.env
.env.*
!.env.example
build/
.pytest_cache/
*.egg-info/

# Local run orchestration and private machine settings.
/configs/*.env
/configs/*.env.*
/docs/*
!/docs/BASELINE.md
!/docs/core-downloads.tsv
!/docs/core.sha256
/scripts/*.sh
!/scripts/select-free-gpu.sh
/scripts/prepare-local.py
/Dockerfile.hotfix
/.cache/
/catboost_info/
/weights/
*.pt
*.joblib
*.safetensors
*.bin
*.npy
*.npz
*.sqlite

/reproduce/
/predictions.csv

/retrain/
*.parquet
